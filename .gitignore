app/.pub/

# Android Studio & Gradle Build Output
app/android/.gradle/
app/android/.kotlin/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
*.apk
*.aab

# IDE & Editor Files
.idea/
*.iml
*.ipr
*.iws
