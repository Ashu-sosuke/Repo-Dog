.env
*.env
*.env.local
*.env.production
serviceAccountKey.json
backend/serviceAccountKey.json
*.pem
*.key

# Python Virtual Environments & Caches
.venv/
venv/
ENV/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Node.js Dependencies
node_modules/

# Diagnostic & Temporary Local Utility Scripts
check_db.py
manual_token_inject.py
diagnose_sync.py
test_upsert.py
run_sync_now.py

# Flutter & Dart Build Artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
